# Credentials for the Urja Meter Ops portal. Copy this file to `.env` and fill it in.
# `.env` is git-ignored: never commit real credentials.
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
PORTAL_EMAIL=operator@example.com
PORTAL_PASSWORD=change-me

# Where the local index lives (created on first sync).
DATABASE_PATH=./data/urja.db

# Be a good citizen with a utility's portal.
MAX_CONCURRENCY=2
POLITE_DELAY_MS=120
REQUEST_TIMEOUT_SECONDS=20

# Refresh policy: sync on boot when the index is empty, then every N minutes.
AUTO_SYNC_ON_START=true
SYNC_ENERGY_ON_START=true
SYNC_INTERVAL_MINUTES=60

LOG_LEVEL=INFO
