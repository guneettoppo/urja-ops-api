            "name": "feeder_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Feeder code, e.g. `F-012`.",
              "title": "Feeder Code"
            },
            "description": "Feeder code, e.g. `F-012`."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness of this service (not of the portal)",
        "description": "Reports whether the local index is queryable. Deliberately does **not** call the portal: the service keeps serving the index when the upstream is down, which is the point of caching it.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sync/status": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Index freshness and last sync outcome",
        "description": "How stale the index is, whether the last sync failed partially, and whether a sync is running right now.\n\n`dataAgeSeconds` is the freshness of *our copy*. `counts.lastReadingAt` is the newest reading the portal actually holds — a different question, and in this dataset the answer is months old.",
        "operationId": "sync_status_sync_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncStatus"
                }
              }
            }
          }
        }
      }
    },
    "/sync": {
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Trigger a sync now",
        "description": "Starts a sync in the background and returns immediately. `409` if one is already running; poll `/sync/status` for progress.",
        "operationId": "trigger_sync_sync_post",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Trigger Sync Sync Post"
                }
              }
            }
          }
        }
      }
    }
  },
