{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Ops API",
    "description": "A clean REST API over the legacy **Urja Meter Ops** portal.\n\nThe portal has no API of its own: this service logs into it, indexes its data\nlocally, and serves a documented, typed, queryable surface on top.\n\n**Design notes that matter when consuming this API**\n\n* Energy values from the portal are *cumulative register readings*. Everything\n  returned by `/meters/{id}/consumption` is a derived delta and is flagged\n  `derived: true`.\n* Sampling granularity varies **per meter** in the source data (30-minute or\n  daily). Responses state the source granularity rather than hiding it.\n* The portal's readings stop at a fixed date. `/sync/status` reports both how\n  fresh our copy is (`dataAgeSeconds`) and how recent the underlying data is\n  (`counts.lastReadingAt`).\n* Errors are RFC 9457 `application/problem+json`. `404` means \"no such meter\";\n  `503` means the portal is unreachable — retry those.",
    "contact": {
      "name": "Urja Ops API"
    },
    "license": {
      "name": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/meters": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "List and filter meters",
        "description": "Filter the indexed meter population. Every filter is applied server-side against the local index — the portal itself only supports a substring search over meter id and serial number.\n\nPagination is keyset-based: pass `pageInfo.nextCursor` back as `cursor`.",
        "operationId": "list_meters_meters_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring match on meter id or serial number.",
              "title": "Q"
            },
            "description": "Substring match on meter id or serial number."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`installed`, `faulty` or `decommissioned`.",
              "title": "Status"
            },
            "description": "`installed`, `faulty` or `decommissioned`."
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Meter manufacturer, case-insensitive (e.g. `Genus`).",
              "title": "Make"
            },
            "description": "Meter manufacturer, case-insensitive (e.g. `Genus`)."
          },
          {
            "name": "phase",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "single",
                    "three"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Supply phase.",
              "title": "Phase"
            },
            "description": "Supply phase."
          },
          {
            "name": "feeder",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Feeder code, e.g. `F-012`.",
              "title": "Feeder"
            },
            "description": "Feeder code, e.g. `F-012`."
          },
          {
            "name": "dt",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Distribution transformer code, e.g. `DT-005`.",
              "title": "Dt"
            },
            "description": "Distribution transformer code, e.g. `DT-005`."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Page size.",
              "default": 50,
              "title": "Limit"
            },
            "description": "Page size."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`pageInfo.nextCursor` from the previous page.",
              "title": "Cursor"
            },
            "description": "`pageInfo.nextCursor` from the previous page."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Meter detail",
        "description": "Full attributes, network position and data-quality notes for one meter. Returns `404` when the meter is not in the index — distinct from `503`, which means the portal itself is unreachable.",
        "operationId": "get_meter_meters__meter_id__get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such meter"
          },
          "503": {
            "description": "Portal unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}/consumption": {
      "get": {
        "tags": [
          "consumption"
        ],
        "summary": "Derived consumption series",
        "description": "Consumption computed as the difference between consecutive cumulative register readings.\n\n* `interval=auto` — one point per native reading interval (30m or 1d, per meter).\n* `interval=30m` — only valid for meters whose source is half-hourly; `422` otherwise.\n* `interval=1d` — points aggregated onto IST calendar days.\n\nIntervals where either register value is missing are omitted and counted in `meta.suppressedPoints`. A negative difference is emitted with `anomaly: \"register_reset\"` rather than silently clamped.",
        "operationId": "meter_consumption_meters__meter_id__consumption_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Meter id, e.g. `J100000`.",
              "title": "Meter Id"
            },
            "description": "Meter id, e.g. `J100000`."
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "auto",
                "30m",
                "1d"
              ],
              "type": "string",
              "description": "Output bucket size. `auto` follows the meter's native granularity.",
              "default": "auto",
              "title": "Interval"
            },
            "description": "Output bucket size. `auto` follows the meter's native granularity."
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO-8601 lower bound (inclusive).",
              "title": "From"
            },
            "description": "ISO-8601 lower bound (inclusive)."
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO-8601 upper bound (inclusive).",
              "title": "To"
            },
            "description": "ISO-8601 upper bound (inclusive)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such meter"
          },
          "422": {
            "description": "Interval finer than the source data"
          }
        }
      }
    },
    "/network/hierarchy": {
      "get": {
        "tags": [
          "network"
        ],
        "summary": "Network hierarchy tree",
        "description": "The zone → … → DT tree reconstructed from per-meter paths, with meter counts at every level.\n\n`to` trims the tree: `to=feeder` returns zones through feeders only. Nodes whose source code was blank are emitted with `code: null` rather than dropped, so the meter counts always add up to the population.",
        "operationId": "hierarchy_network_hierarchy_get",
        "parameters": [
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "zone",
                "circle",
                "division",
                "subdivision",
                "substation",
                "feeder",
                "dt"
              ],
              "type": "string",
              "description": "Deepest level to include.",
              "default": "dt",
              "title": "To"
            },
            "description": "Deepest level to include."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HierarchyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
